-.input { width: 100%; min-height: 60px; border: 1px solid #ac8b55; border-radius: 999px; padding: .85rem 1.25rem .85rem 3.5rem; background: transparent; color: #253147; font-size: 1rem; }
-.input::placeholder { color: #59534d; opacity: 1; }
-.input:focus-visible { outline: 2px solid #936f31; outline-offset: 3px; }
-.submit { display: inline-flex; align-items: center; justify-content: center; gap: 1rem; min-height: 60px; min-width: 180px; padding: .85rem 1.5rem; border-radius: 999px; background: #932e32; color: white; font-weight: 600; font-size: 1rem; transition: background .15s; }
-.submit:hover { background: #701f23; }
