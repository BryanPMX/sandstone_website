-.scene::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, #071a31e8 0%, #071a3199 42%, #071a311a 76%), linear-gradient(0deg, #071a3155, transparent 40%); }
-.heroInner { max-width: 1280px; margin: auto; padding: 4.5rem 2rem 8rem; }
-.eyebrow { color: #e5c58b; font-size: .8rem; line-height: 1.8; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; }
-.eyebrow::after { content: ""; display: block; width: 64px; height: 1px; margin-top: 1.25rem; background: #d1ac69; }
-.heading { max-width: 680px; margin: 1.5rem 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(3rem, 5.3vw, 5rem); line-height: 1.04; font-weight: 700; letter-spacing: -.04em; text-wrap: balance; }
-.heading span { display: block; }
-.intro { max-width: 450px; font-size: 1.15rem; line-height: 1.7; }
