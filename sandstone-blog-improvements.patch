+/** Use the local calendar month so event guides expire at El Paso midnight. */
+export function getBlogMonth(date = new Date()): string {
+  const parts = new Intl.DateTimeFormat("en-US", {
+    year: "numeric",
+    month: "2-digit",
+    timeZone: "America/Denver",
+  }).formatToParts(date);
+  return `${parts.find((part) => part.type === "year")!.value}-${parts.find((part) => part.type === "month")!.value}`;
+}
