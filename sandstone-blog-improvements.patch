@@ -0,0 +1,123 @@
+"use client";
+
+import { useState } from "react";
+import { getCategoryLabel } from "@/config/blog-areas";
+import type { BlogPostListItem } from "@/types";
+import { BlogCard } from "./BlogCard";
+
+export function BlogBrowse({
+  posts,
+  currentMonth,
+}: {
+  posts: BlogPostListItem[];
+  currentMonth: string;
+}) {
+  const [query, setQuery] = useState("");
+  const [showArchive, setShowArchive] = useState(false);
+  const terms = query.toLowerCase().trim().split(/\s+/).filter(Boolean);
+  const matching = posts.filter((post) => {
+    const text = [
+      post.title,
+      post.cardTitle,
+      post.excerpt,
+      post.location,
+      getCategoryLabel(post.area),
+      ...(post.keywords || []),
+    ]
+      .join(" ")
+      .toLowerCase();
+    return terms.every((term) => text.includes(term));
+  });
+  const archived = matching.filter(
+    (post) => post.eventMonth && post.eventMonth < currentMonth,
+  );
+  const current = matching.filter(
+    (post) => !post.eventMonth || post.eventMonth >= currentMonth,
+  );
+  return (
+    <section className="mt-10" aria-labelledby="articles-heading">
+      <div className="flex flex-wrap items-end justify-between gap-4">
+        <h2
+          id="articles-heading"
+          className="font-heading text-2xl font-bold text-[var(--sandstone-navy)] md:text-3xl"
+        >
+          Latest Articles
+        </h2>
+        <div className="w-full sm:w-80">
+          <label
+            htmlFor="blog-search"
+            className="mb-2 block text-sm font-medium text-[var(--sandstone-charcoal)]"
+          >
+            Search articles
+          </label>
+          <input
+            id="blog-search"
+            type="search"
+            value={query}
+            onChange={(event) => setQuery(event.target.value)}
+            placeholder="Try PCS, taxes, or neighborhoods"
+            className="w-full rounded-xl border border-[var(--sandstone-navy)]/25 bg-white px-4 py-3 text-sm text-[var(--sandstone-charcoal)] focus:outline-none focus:ring-2 focus:ring-[var(--sandstone-navy)]"
+          />
+        </div>
+      </div>
+      <p
+        className="mt-4 text-sm text-[var(--sandstone-charcoal)]/70"
+        role="status"
+      >
+        {current.length} {current.length === 1 ? "article" : "articles"}
+        {archived.length > 0 &&
+          ` · ${archived.length} past event guides in the archive`}
+      </p>
+      {current.length > 0 ? (
+        <div className="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
+          {current.map((post) => (
+            <BlogCard key={post.slug} post={post} />
+          ))}
+        </div>
+      ) : (
+        <p className="mt-6 rounded-2xl bg-white p-6 text-[var(--sandstone-charcoal)]">
+          {query
+            ? "No current articles match your search. Try another topic or check the event archive below."
+            : "New resources are coming soon. Explore other topics or browse the event archive below."}
+        </p>
+      )}
+      {archived.length > 0 && (
+        <div className="mt-10">
+          <button
+            type="button"
+            aria-expanded={showArchive}
+            aria-controls="event-archive"
+            onClick={() => setShowArchive(!showArchive)}
+            className="rounded-full border border-[var(--sandstone-navy)]/30 px-5 py-3 font-semibold text-[var(--sandstone-navy)] hover:bg-white focus-visible:outline focus-visible:outline-2"
+          >
+            {showArchive ? "Hide" : "Show"} past event guides ({archived.length}
+            )
+          </button>
+          <div id="event-archive" hidden={!showArchive}>
+            <h3 className="mt-6 font-heading text-2xl font-bold text-[var(--sandstone-navy)]">
+              Event Archive
+            </h3>
+            <p className="mt-2 text-sm text-[var(--sandstone-charcoal)]/75">
+              These guides cover past months. Event dates and availability may
+              have changed.
+            </p>
+            <div className="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
+              {archived.map((post) => (
+                <BlogCard key={post.slug} post={post} archived />
+              ))}
+            </div>
+          </div>
+        </div>
+      )}
+      {query && (
+        <button
+          type="button"
+          onClick={() => setQuery("")}
+          className="mt-5 text-sm font-semibold text-[var(--sandstone-navy)] underline"
+        >
+          Clear search
+        </button>
+      )}
+    </section>
+  );
+}
